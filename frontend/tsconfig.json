/**
 * TypeScript is here only for the type declarations the frontend leans on:
 * src/vite-env.d.ts and the .d.ts files wails3 generates beside the bindings.
 * The app itself is plain JavaScript — allowJs is off, so `npm run typecheck`
 * checks those declarations, not the pages or the modules behind them.
 */
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "bindings"],
  "exclude": ["node_modules", "dist", "build"]
}
